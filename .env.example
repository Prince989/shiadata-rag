# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# REQUIRED. Every collection was embedded with an OpenAI model, so without this
# the service now refuses to start rather than booting and 401-ing on the first
# query.
OPENAI_API_KEY=sk-...

# At least one is REQUIRED for the LLM-backed routes. Vector search still works
# without them -- those subsystems simply report as degraded.
# Duplicates are collapsed, so repeating the same key does not increase quota.
GOOGLE_API_KEY=
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=

# ---------------------------------------------------------------------------
# Internal auth
# ---------------------------------------------------------------------------
# Shared secret for the NestJS -> Python hop. Every data route requires it in
# the X-Internal-API-Key header; /api/v1/health stays open for probes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Localhost by default: this service is not internet-facing.
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
RELOAD=false
THREAD_POOL_SIZE=24

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
THEOLOGY_LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Retrieval defaults
# ---------------------------------------------------------------------------
THEOLOGY_TOP_K=7
THEOLOGY_FETCH_K=30
THEOLOGY_LAMBDA_MULT=0.5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Retrieved chunks are book text and user questions. Keep this off outside
# local debugging -- it used to print every chunk in full on every request.
LOG_RETRIEVED_CHUNKS=false
